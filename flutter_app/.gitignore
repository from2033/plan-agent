# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
**/xcshareddata/swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Ruby/Bundler local dependencies
/.bundle/
/vendor/bundle/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release

# Fastlane generates local reports and screenshots during release runs.
/ios/fastlane/report.xml
/ios/fastlane/screenshots/
/ios/fastlane/test_output/
/ios/fastlane/.env*
/ios/fastlane/*api_key*.json
/ios/fastlane/*credentials*.json
