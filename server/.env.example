# 复制为 .env 并填入真实值（.env 不要提交到版本库）

# Anthropic API key —— 用于大模型解析。不填则自动回退到正则解析。
ANTHROPIC_API_KEY=

# 访问令牌 —— 前端每个请求都要带这个，防止陌生人访问你的服务器。
# 自己随便设一个长一点的随机串。
ACCESS_TOKEN=change-me-to-a-long-random-string

# 监听端口
PORT=8787

# SQLite 数据库文件路径
DB_PATH=./data.db

# 允许的前端来源（CORS）。同源部署可留空或设为 *。
# 例如本地开发：http://localhost:5173
CORS_ORIGIN=*

# 邮箱验证码登录（生产环境 AUTH_SECRET 至少 32 字符）。
AUTH_SECRET=
PRIMARY_EMAIL=
ALLOWED_EMAILS=
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=service@notice.5656ai.com
SMTP_PASS=
SMTP_FROM=5656AI <service@notice.5656ai.com>

# App Store 审核专用登录：账号无需真实邮箱；Code 明文只放 macOS Keychain
# 和 App Store Connect，服务器仅配置小写 SHA-256 哈希。
APP_REVIEW_EMAIL=
APP_REVIEW_CODE_HASH=

# Mac Codex worker：这里只保存原始令牌的 SHA-256，不保存明文令牌。
CODEX_WORKER_TOKEN_HASH=
CODEX_WORKER_LEASE_SECONDS=180
CODEX_WORKER_MAX_ATTEMPTS=3
